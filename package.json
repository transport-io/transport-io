{
  "name": "transport-io-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "site"
  ],
  "scripts": {
    "bench:stream-churn": "./scripts/check-node.sh && node --expose-gc packages/core/src/bench/stream-churn.node.ts",
    "build": "tsc --build",
    "check:boundaries": "bun run scripts/check-boundaries.ts",
    "check:gate-inputs": "bun run scripts/check-gate-inputs.ts",
    "check:hover": "bun run scripts/check-hover.ts",
    "check:install": "bun run scripts/check-install-line.ts",
    "check:node": "./scripts/check-node.sh",
    "check:norms": "bun run scripts/check-norms.ts",
    "check:required": "bun run scripts/required-checks.ts",
    "check:site-links": "bun run scripts/check-site-links.ts",
    "check:ts-floor": "./scripts/check-ts-floor.sh",
    "check:workflows": "bun run scripts/check-workflows.ts",
    "commitlint": "commitlint",
    "deadcode": "knip",
    "docs:check": "bun run scripts/check-docs.ts",
    "e2e": "playwright test",
    "e2e:server": "npm run check:node && npm run build && cd examples/chat && bun run cert && bun run build:web && node server.node.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "biome check --no-errors-on-unmatched",
    "preflight": "bun run scripts/check-gate-inputs.ts && bun run scripts/check-install-line.ts && npm run verify:pack",
    "prepare": "lefthook install",
    "soak": "./scripts/check-node.sh && node --expose-gc scripts/soak.node.ts",
    "soak:churn": "./scripts/check-node.sh && node --expose-gc scripts/soak-churn.node.ts",
    "soak:lanes": "./scripts/check-node.sh && node --expose-gc scripts/soak.node.ts --lanes emit,unreliable",
    "test:node": "./scripts/run-node-tests.sh",
    "test:unit": "bun test --path-ignore-patterns=\"**/*.node.test.ts\" --path-ignore-patterns=\"e2e/**\"",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "verify:pack": "bun run scripts/check-gate-inputs.ts && npm run build && npm -w packages/core pack --pack-destination /tmp && attw --pack packages/core --profile esm-only && publint packages/core && ./scripts/check-ts-floor.sh"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.7",
    "@moq/web-transport": "^0.1.4",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "expect-type": "^1.4.0",
    "fast-check": "^4.9.0",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "publint": "^0.3.24",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  }
}
