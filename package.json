{
  "name": "transport-io-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "check:node": "./scripts/check-node.sh",
    "commitlint": "commitlint",
    "deadcode": "knip",
    "docs:check": "bun run scripts/check-docs.ts",
    "e2e": "playwright test",
    "e2e:server": "npm run check:node && cd examples/chat && bun run cert && bun run build:web && node server.node.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:staged": "biome check --no-errors-on-unmatched",
    "prepare": "lefthook install",
    "test:node": "node --test \"packages/*/src/**/*.node.test.ts\"",
    "test:unit": "bun test --path-ignore-patterns=\"**/*.node.test.ts\" --path-ignore-patterns=\"e2e/**\"",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json",
    "verify:pack": "npm run build && npm -w packages/core pack --pack-destination /tmp && attw --pack packages/core --profile esm-only && publint packages/core"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.10",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@fails-components/webtransport-transport-http3-quiche": "^1.6.7",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.0",
    "expect-type": "^1.4.0",
    "fast-check": "^4.9.0",
    "knip": "^6.32.2",
    "lefthook": "^2.1.10",
    "publint": "^0.3.24",
    "typescript": "^7.0.2"
  }
}
