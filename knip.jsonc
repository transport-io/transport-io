{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@fails-components/webtransport-transport-http3-quiche",
    "zod",
    "@moq/web-transport"
  ],
  "ignoreBinaries": [
    "openssl"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/bench/*.node.ts",
        "src/**/*.test.ts",
        "src/**/*.test-d.ts",
        "src/**/*.node.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "examples/chat": {
      // The contract file exports `ChatMap` and then consumes it itself, in the
      // `declare module` block that registers it. Nothing imports it, because that is
      // exactly what registering buys, and the export stays because a reader copying this
      // file into a real application will want it. An export a file uses itself is not
      // dead, and this says so for the example only.
      "ignoreExportsUsedInFile": true,
      "entry": [
        "web/main.ts",
        "scripts/*.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "site": {
      "entry": [
        "src/loaders/*.ts",
        "src/content/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
