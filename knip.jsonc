{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@fails-components/webtransport-transport-http3-quiche",
    "zod",
    "@moq/web-transport"
  ],
  "ignoreBinaries": [
    "openssl"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/bench/*.node.ts",
        "src/**/*.test.ts",
        "src/**/*.test-d.ts",
        "src/**/*.node.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "examples/chat": {
      "entry": [
        "web/main.ts",
        "scripts/*.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "site": {
      "entry": [
        "src/loaders/*.ts",
        "src/content/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
