{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": [
    "@fails-components/webtransport-transport-http3-quiche",
    "zod",
    "@moq/web-transport"
  ],
  "ignoreBinaries": [
    "openssl"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ]
    },
    "packages/core": {
      "entry": [
        "src/bench/*.node.ts",
        "src/**/*.test.ts",
        "src/**/*.test-d.ts",
        "src/**/*.node.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/react": {
      // The hooks are the entry; the tests and the type tests are entries too, because a
      // test file is not dead code and knip cannot tell the difference on its own. The
      // harness consumes its own `TestMap` in a `declare module` block, which is a use knip
      // does not follow, so an export a file uses itself is not dead here either.
      "ignoreExportsUsedInFile": true,
      "entry": [
        "src/**/*.test.tsx",
        "src/**/*.test-d.ts"
      ],
      "project": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ]
    },
    "examples/chat": {
      "entry": [
        "web/main.ts",
        "web/agents.ts",
        "scripts/*.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "site": {
      "entry": [
        "src/loaders/*.ts",
        "src/content/**"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  }
}
