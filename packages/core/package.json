{
  "name": "transport-io",
  "version": "0.5.0",
  "description": "Real-time apps over WebTransport. Two lanes, one contract, no fallback.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser-transport": {
      "types": "./dist/transport/browser.d.ts",
      "default": "./dist/transport/browser.js"
    },
    "./dev-transport": {
      "types": "./dist/transport/dev.d.ts",
      "default": "./dist/transport/dev.js"
    },
    "./node-transport": {
      "types": "./dist/transport/fails.node.d.ts",
      "default": "./dist/transport/fails.node.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/bench",
    "!dist/cli/**/*.d.ts",
    "!dist/cli/**/*.d.ts.map",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@fails-components/webtransport": "1.6.7",
    "@standard-schema/spec": "^1.1.0"
  },
  "optionalDependencies": {
    "@moq/web-transport-darwin-arm64": "0.1.4",
    "@moq/web-transport-darwin-x64": "0.1.4",
    "@moq/web-transport-linux-arm64-gnu": "0.1.4",
    "@moq/web-transport-linux-x64-gnu": "0.1.4",
    "@moq/web-transport-win32-x64-msvc": "0.1.4"
  },
  "author": "#V0ID <hey@v0id.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/transport-io/transport-io.git",
    "directory": "packages/core"
  },
  "bin": {
    "transport-io": "./dist/cli/main.node.js"
  }
}
