{
  "$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*.ts", "**/*.json", "!dist", "!node_modules"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 96
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "correctness": {
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.ts", "!**/*.node.ts", "!**/*.node.test.ts", "!scripts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@fails-components/webtransport": "The transport may only be imported from *.node.ts or *.node.test.ts. It loads a native addon that segfaults Bun on exit (DECISIONS.md D14, ADR 0006).",
                  "@fails-components/webtransport-transport-http3-quiche": "The transport may only be imported from *.node.ts or *.node.test.ts. See DECISIONS.md D14.",
                  "@moq/web-transport": "The transport may only be imported from *.node.ts or *.node.test.ts. See DECISIONS.md D14."
                }
              }
            }
          }
        }
      }
    }
  ]
}
