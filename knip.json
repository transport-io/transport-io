{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["@fails-components/webtransport-transport-http3-quiche"],
  "ignoreBinaries": ["openssl"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/testing/index.ts",
        "src/**/*.test.ts",
        "src/**/*.test-d.ts",
        "src/**/*.node.test.ts"
      ],
      "project": ["src/**/*.ts"]
    }
  }
}
